NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only this address can sign in
ALLOWED_EMAIL=you@example.com
# Fallback origin for magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Weight unit label shown in the app (lb or kg)
NEXT_PUBLIC_WEIGHT_UNIT=lb
# Classes: encrypts stored source tokens/cookies (openssl rand -base64 32)
CREDENTIALS_KEY=
# Classes: shared secret Vercel Cron sends to /api/cron/classes (openssl rand -base64 32)
CRON_SECRET=
# Classes: server-only Supabase secret key, used by the cron job (never NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_...
